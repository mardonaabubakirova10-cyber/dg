# Скопируйте в .env и вставьте ключ из https://aistudio.google.com/apikey
# Без ключа ассистент работает без LLM: отдаёт найденные фрагменты базы знаний.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Папка Google Drive для компьютера (там courses_data.xlsx и knowledge_base_word/).
# Если пусто, используется локальная storage_drive/.
DRIVE_FOLDER=

# Google Drive через API (сервисный аккаунт). Папку нужно расшарить на его email.
# Локально: путь к JSON-ключу. На Vercel: GOOGLE_SERVICE_ACCOUNT_JSON = всё содержимое JSON.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Таблица для заявок с сайта (создать самому и дать доступ редактора сервисному аккаунту).
# Пусто — заявки пишутся в leads.jsonl.
GOOGLE_LEADS_SHEET_ID=
