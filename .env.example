# Скопируйте в .env и вставьте ключ из https://aistudio.google.com/apikey
# Без ключа ассистент работает без LLM: отдаёт найденные фрагменты базы знаний.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Папка Google Drive для компьютера (там courses_data.xlsx и knowledge_base_word/).
# Если пусто, используется локальная storage_drive/.
DRIVE_FOLDER=
